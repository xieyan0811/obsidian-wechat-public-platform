#nice .layout {}

#nice p {
  color: #3e3e3e;
  font-size: 14px;
  font-weight: 400;
  text-align: left;
  text-indent: 0px;
  word-spacing: 0px;
}

#nice h1 {
  font-size: 20px;
  font-weight: bold;
  color: #ffffff;
  margin: 1em auto 1em;
  background-color: #009874;
  padding: 1em 1em;
  border-radius: 8px;
  display: table;
  text-align: center;
}

#nice h2 {
  font-size: 18px;
  font-weight: bold;
  margin: 2em auto 1em;
  color: #009874;
  background-color: rgba(0, 152, 116, 0.1);
  padding: 0.5em 1em;
  text-align: left;
  border-left: 4px solid #009688;
}

#nice h3 {
  font-size: 16px;
  font-weight: bold;
  margin: 2em 8px 1em 0px;
  color: #009874;
  text-align: left;
  padding-left: 10px;
  border-left: 3px solid #009688;
}

#nice h4 {
  font-size: 15px;
  font-weight: bold;
  margin: 1.5em 8px 1em;
  orphans: 2;
  text-align: left;
  color: #009874;
  padding-left: 10px;
  border-left: 2px solid #009688;
}

#nice li {
  font-size: 14px;
  color: #000;
  margin-bottom: 10px;
}

#nice li strong {
  font-size: 14px;
  color: #000;
  margin-bottom: 10px;
}

#nice p code, #nice li code {
  color: #5f5deee7;
  line-height: 1.5;
  font-size: 14px;
  padding: 3px 5px;
  border-radius: 2px;
}

#nice blockquote {
  border-left: 2px solid #888;
  border-right: 2px solid #888;
  padding-left: 1em;
  color: #777;
}

#nice a {
  font-size: 14px;
  color: #009688;
  border-bottom: 1px solid #009688;
}

#nice strong {
  font-size: 14px;
}

#nice hr {
  margin: 20px 0;
}

#nice table tr th {
  font-size: 14px;
  border: 1px solid #009688;
  background-color: #009688;
  color: #f8f8f8;
  border-bottom: 0;
}

#nice .footnote-word {
  color: #009688;
}

#nice .footnote-ref {
  color: #009688;
}